# 공유용 압축본 (원본 파일과 중복)
*.zip
# 로컬 도구 설정
.claude/
# OS
Thumbs.db
desktop.ini
# 공유용 압축 파일
UX_AI_TEST_Workbench.zip
UX_AI_TEST_Workbench_Mac.zip
workbench/.watcher.json
workbench/.plan_usage.json
# 백그라운드 Claude 에이전트 상태 · 기록(PC마다)
workbench/.agent.json
workbench/.agent_stop
workbench/.agent_renew
workbench/.agent.lock
workbench/.installed
workbench/.agent.log
workbench/.agent_prompt.txt
workbench/.agent_out.txt
workbench/.agent_out.txt.err
# 작업 이력(공유)은 별도 저장소(history 브랜치)로 서버가 올린다
.history/
workbench/.history_sync.json
workbench/.history_sync_now
workbench/.history_sync.lock
# 자동 업데이트(release 브랜치 받기) · 배포 작업 폴더 · 설치용 압축
.update/
.release/
workbench/.update.json
dist/
workbench/guide_apply.json
# 프로토타입은 PC마다 따로(저장소 · 배포본에 넣지 않는다)
prototypes/
# PC마다 따로 쌓이는 데이터(서버가 없으면 빈 파일로 만든다)
workbench/edit_requests.json
workbench/jobs.json
workbench/req_images/
workbench/job_files/
workbench/.run/
workbench/.sheet_cache/
# 프로젝트(Figma 파일)는 PC마다 따로(기본 프로젝트 없음, 시작 안내 3단계 링크로 정한다)
projects/
# 이력 동기화 · 서버가 쓰는 동안 잠깐 생기는 임시 파일
workbench/*.tmp
# 바로가기(서버가 PC마다 만듦, 폴더 위치가 들어감)
/Figma AI Run.lnk
